{
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "predeploy": [
        "node scripts/sync-functions-lib.js"
      ]
    }
  ],
  "hosting": {
    "site": "nbadraftpick",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backups/**",
      "supabase/**",
      "functions/**",
      "scripts/**",
      "tests_*/**",
      "test_*/**",
      "dgggg",
      "README.md",
      "BACKUP_RESTORE.md",
      "package.json",
      "package-lock.json",
      "*.patch",
      "New folder/**"
    ]
  }
}
